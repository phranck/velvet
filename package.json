{
  "name": "velvet",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "npm run build --workspace @velvet/contracts && npm run build --workspace @velvet/site",
    "test": "npm run test --workspace @velvet/contracts",
