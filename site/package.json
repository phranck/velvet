{
  "name": "@velvet/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preconfigurator:build": "npm run build --workspace @velvet/contracts",
    "configurator:build": "svelte-check --tsconfig ./tsconfig.json && vite build --config vite.configurator.ts",
    "preview": "vite preview",
    "screenshot": "node scripts/screenshot.mjs",
    "pretest": "npm run build --workspace @velvet/contracts",
    "test": "tsx --test test/*.test.ts",
    "pretypecheck": "npm run build --workspace @velvet/contracts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fontsource/plaster": "^5.3.0",
    "@velvet/contracts": "1.0.0"
  },
  "devDependencies": {
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/web": "^2.1.2",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tsconfig/svelte": "^5.0.4",
    "js-yaml": "^4.1.0",
    "playwright": "^1.61.1",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
