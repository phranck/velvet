{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.svelte",
    "test/**/*.ts",
    "theme-bundles/**/*.ts",
    "gallery/**/*.ts",
    "scripts/themes.ts",
    "scripts/theme-screenshots.ts",
    "scripts/verify-themes.ts",
    "scripts/conformance.ts",
    "scripts/verify-conformance.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
