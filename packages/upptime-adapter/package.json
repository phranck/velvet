{
  "name": "@velvet/upptime-adapter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vum": "./dist/vum.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "pretest": "bun run --filter @velvet/contracts build && bun run --filter @velvet/monitor build",
    "test": "bun test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "vum": "bun src/vum.ts"
  },
  "dependencies": {
    "@velvet/contracts": "1.0.0",
    "@velvet/monitor": "1.0.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
