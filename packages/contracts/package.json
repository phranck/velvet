{
  "name": "@velvet/contracts",
  "version": "1.5.4",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "dist",
    "schemas",
    "README.md"
  ],
  "scripts": {
    "build": "bun run schemas && tsc --project tsconfig.build.json",
    "schemas": "bun scripts/write-schemas.ts",
    "test": "bun test test/*.test.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
