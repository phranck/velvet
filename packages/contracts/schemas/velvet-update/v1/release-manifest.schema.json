{
  "$id": "urn:velvet:schema:release-manifest:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable update metadata consumed by the Velvet managed-update service and Configurator.",
  "type": "object",
  "required": [
    "schemaVersion",
    "version",
    "releaseType",
    "automaticInstallEligible",
    "template",
    "compatibility",
    "managedFiles",
    "releaseNotes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "version": {
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    },
    "releaseType": {
      "anyOf": [
        {
          "const": "security",
          "type": "string"
        },
        {
          "const": "fix",
          "type": "string"
        },
        {
          "const": "feature",
          "type": "string"
        }
      ]
    },
    "automaticInstallEligible": {
      "type": "boolean"
    },
    "template": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "minLength": 3,
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "commit": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        }
      }
    },
    "compatibility": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "minimumInstalledVersion",
        "configurationSchemaVersion",
        "dataSchemaVersion",
        "configurationMigrationRequired",
        "dataMigrationRequired"
      ],
      "properties": {
        "minimumInstalledVersion": {
          "minLength": 5,
          "maxLength": 128,
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
          "type": "string"
        },
        "configurationSchemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "dataSchemaVersion": {
          "minimum": 1,
          "type": "integer"
        },
        "configurationMigrationRequired": {
          "type": "boolean"
        },
        "dataMigrationRequired": {
          "type": "boolean"
        }
      }
    },
    "managedFiles": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "strategy",
              "sourcePath",
              "sha256"
            ],
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              },
              "strategy": {
                "const": "replace",
                "type": "string"
              },
              "sourcePath": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              },
              "sha256": {
                "pattern": "^[a-f0-9]{64}$",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "path",
              "strategy",
              "generator"
            ],
            "properties": {
              "path": {
                "minLength": 1,
                "maxLength": 256,
                "type": "string"
              },
              "strategy": {
                "const": "generate",
                "type": "string"
              },
              "generator": {
                "anyOf": [
                  {
                    "const": "maintenance-issue-template-v1",
                    "type": "string"
                  },
                  {
                    "const": "maintenance-workflow-v1",
                    "type": "string"
                  },
                  {
                    "const": "pages-workflow-v1",
                    "type": "string"
                  },
                  {
                    "const": "response-times-workflow-v1",
                    "type": "string"
                  },
                  {
                    "const": "status-workflow-v1",
                    "type": "string"
                  },
                  {
                    "const": "version-lock-v1",
                    "type": "string"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    "releaseNotes": {
      "minLength": 1,
      "maxLength": 65536,
      "type": "string"
    }
  }
}
