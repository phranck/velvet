{
  "$id": "urn:velvet:schema:update-lock:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic record of the Velvet template version installed in a status repository.",
  "type": "object",
  "required": [
    "schemaVersion",
    "installedVersion",
    "template",
    "configurationSchemaVersion",
    "dataSchemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "installedVersion": {
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "type": "string"
    },
    "template": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "minLength": 3,
          "maxLength": 140,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?/[A-Za-z0-9._-]+$",
          "type": "string"
        },
        "commit": {
          "pattern": "^[a-f0-9]{40}$",
          "type": "string"
        }
      }
    },
    "configurationSchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "dataSchemaVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "serial": {
      "minimum": 1,
      "type": "integer"
    }
  }
}
