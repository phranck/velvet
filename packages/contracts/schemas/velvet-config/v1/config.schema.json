{
  "$id": "urn:velvet:schema:configuration:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Canonical configuration for a GitHub-native Velvet status repository.",
  "type": "object",
  "required": [
    "schemaVersion",
    "repository",
    "statusPage",
    "services"
  ],
  "properties": {
    "schemaVersion": {
      "description": "Velvet configuration contract version.",
      "const": 1,
      "type": "number"
    },
    "repository": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "owner",
        "name"
      ],
      "properties": {
        "owner": {
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?$",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9._-]+$",
          "type": "string"
        }
      }
    },
    "statusPage": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "name",
        "theme"
      ],
      "properties": {
        "name": {
          "minLength": 1,
          "maxLength": 128,
          "type": "string"
        },
        "customDomain": {
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$",
          "type": "string"
        },
        "logoUrl": {
          "minLength": 1,
          "maxLength": 2048,
          "type": "string"
        },
        "logoHeight": {
          "minimum": 16,
          "maximum": 256,
          "type": "integer"
        },
        "theme": {
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "description": "The theme the page is published in, named by its directory under site/theme-bundles. Required, because a page is published in a theme and there is nothing to publish without one. A name no installed theme answers to stops the build rather than falling back to another theme.",
          "type": "string"
        },
        "themeSettings": {
          "description": "What has been set on the named theme, keyed by the feature it belongs to. Which keys a theme offers and what each may take is in its own velvet-theme.toml, so the build checks these against that file rather than the schema, which does not know which theme was named.",
          "type": "object",
          "patternProperties": {
            "^[a-z][a-zA-Z0-9]*$": {
              "anyOf": [
                {
                  "maxLength": 128,
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          }
        },
        "layout": {
          "anyOf": [
            {
              "const": "grouped",
              "type": "string"
            },
            {
              "const": "cards",
              "type": "string"
            }
          ]
        },
        "defaultRange": {
          "anyOf": [
            {
              "const": "30d",
              "type": "string"
            },
            {
              "const": "90d",
              "type": "string"
            },
            {
              "const": "all",
              "type": "string"
            }
          ]
        },
        "responseChart": {
          "description": "Whether the page shows the response-time chart under each service. On unless set otherwise. It is a page setting rather than a theme one, because it is about what the page reports rather than how a theme draws it, and every theme honours it.",
          "type": "boolean"
        },
        "navigation": {
          "maxItems": 16,
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "title",
              "href"
            ],
            "properties": {
              "title": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "href": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        "icons": {
          "type": "object",
          "patternProperties": {
            "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            }
          }
        },
        "seo": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "title": {
              "minLength": 1,
              "maxLength": 128,
              "type": "string"
            },
            "description": {
              "minLength": 1,
              "maxLength": 300,
              "type": "string"
            },
            "image": {
              "minLength": 1,
              "maxLength": 2048,
              "type": "string"
            }
          }
        }
      }
    },
    "services": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "description": "Public service component. Use name plus url for one default check, or checks for multiple named endpoints.",
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
            "description": "Stable lowercase kebab-case identifier.",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "url": {
            "minLength": 1,
            "maxLength": 2048,
            "type": "string"
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "name",
                "url"
              ],
              "properties": {
                "id": {
                  "minLength": 1,
                  "maxLength": 64,
                  "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
                  "description": "Stable lowercase kebab-case identifier.",
                  "type": "string"
                },
                "name": {
                  "minLength": 1,
                  "maxLength": 128,
                  "type": "string"
                },
                "url": {
                  "minLength": 1,
                  "maxLength": 2048,
                  "type": "string"
                },
                "method": {
                  "description": "Safe HTTP method. Velvet supports GET and HEAD.",
                  "type": "string"
                },
                "expectedStatusCodes": {
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "description": "Final HTTP status codes that count as healthy. Defaults to only 200.",
                  "type": "array",
                  "items": {
                    "type": "integer"
                  }
                },
                "maxRedirects": {
                  "minimum": 0,
                  "maximum": 10,
                  "description": "Maximum followed redirects. Defaults to 5.",
                  "type": "integer"
                },
                "timeoutMs": {
                  "minimum": 100,
                  "maximum": 60000,
                  "description": "Absolute request timeout in milliseconds across all redirects. Defaults to 10000.",
                  "type": "integer"
                },
                "headers": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "name",
                      "secret"
                    ],
                    "properties": {
                      "name": {
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "HTTP header name.",
                        "type": "string"
                      },
                      "secret": {
                        "minLength": 1,
                        "maxLength": 128,
                        "description": "Environment-variable name containing the header value. Secret values never belong in velvet.yml.",
                        "type": "string"
                      }
                    }
                  }
                },
                "jsonAssertions": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "description": "Optional explicit JSON health assertion. Status-only checks do not inspect the response body.",
                    "type": "object",
                    "required": [
                      "path",
                      "equals"
                    ],
                    "properties": {
                      "path": {
                        "minLength": 1,
                        "maxLength": 256,
                        "description": "RFC 6901 JSON Pointer identifying the response value.",
                        "type": "string"
                      },
                      "equals": {
                        "anyOf": [
                          {
                            "maxLength": 1024,
                            "type": "string"
                          },
                          {
                            "type": "number"
                          },
                          {
                            "type": "boolean"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "incidents": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "failureThreshold": {
          "minimum": 1,
          "maximum": 20,
          "type": "integer"
        },
        "recoveryThreshold": {
          "minimum": 1,
          "maximum": 20,
          "type": "integer"
        },
        "incidentLabel": {
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "description": "Stable lowercase kebab-case identifier.",
          "type": "string"
        },
        "maintenanceLabel": {
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "description": "Stable lowercase kebab-case identifier.",
          "type": "string"
        }
      }
    },
    "history": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "retentionDays": {
          "minimum": 1,
          "maximum": 365,
          "type": "integer"
        }
      }
    },
    "gallery": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "listed"
      ],
      "properties": {
        "listed": {
          "description": "Name this installation as a reference on the Velvet website. Off unless the owner has said otherwise.",
          "type": "boolean"
        }
      }
    },
    "updates": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "automaticSecurityUpdates": {
          "description": "Install compatible security-only releases automatically after their update pull request passes all checks.",
          "type": "boolean"
        }
      }
    }
  }
}
