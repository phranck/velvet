node_modules/
dist/
velvet-dist/
site/public/CNAME
# The website is uploaded by the Pages workflow rather than committed, unlike
# onboarding/ and configurator/, which the setup service serves from the tree.
site/dist-website/
*.tsbuildinfo
.DS_Store

# The setup service build writes this from the sources it was made from, so a
# committed copy would only ever hold the previous build's value. Every gate
# that needs it regenerates it first.
apps/setup-service/src/deployment-fingerprint.generated.ts

# Local agent workspaces, never published
.claude/
.codex/
.serena/

# Local credentials for verification runs, never committed.
# The wildcard is load-bearing: an editor that appends .txt on save produces a
# file that .env.local alone does not match, leaving a private key untracked but
# not ignored, and one `git add -A` from being committed.
.env.local*
.env*

# Cut from the Phosphor face at build time to the icons Velvet names.
site/src/assets/phosphor-duotone-subset.woff2
