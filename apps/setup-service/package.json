{
  "name": "@velvet/setup-service",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "prebuild": "bun run --filter @velvet/contracts build && bun run --filter @velvet/site onboarding:build",
    "build": "bun run scripts/build.ts",
    "pretest": "bun run --filter @velvet/contracts build",
    "test": "bun test test/*.test.ts",
    "pretypecheck": "bun run --filter @velvet/contracts build",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@velvet/contracts": "1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
