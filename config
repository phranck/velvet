#!/usr/bin/env node

import { createHash, randomUUID } from "node:crypto";
import {
  closeSync,
  createReadStream,
  existsSync,
  mkdirSync,
  openSync,
  readFileSync,
  statSync,
  unlinkSync,
  writeFileSync,
} from "node:fs";
import { createServer } from "node:http";
import { tmpdir } from "node:os";
import {
  dirname,
  extname,
  isAbsolute,
  relative,
  resolve,
  sep,
} from "node:path";
import { spawn, execFileSync } from "node:child_process";
import { fileURLToPath } from "node:url";

const HOST = "127.0.0.1";
const PORT = 2342;
export const CONFIGURATOR_URL = `http://${HOST}:${PORT}`;

const COMMAND_PATH = fileURLToPath(import.meta.url);
const PROJECT_ROOT = dirname(COMMAND_PATH);
const WEB_ROOT = resolve(PROJECT_ROOT, "configurator");
const INSTANCE_ID = createHash("sha256")
  .update(PROJECT_ROOT)
  .digest("hex")
  .slice(0, 12);
const STATE_ROOT = resolve(tmpdir(), `velvet-configurator-${INSTANCE_ID}`);
const STATE_FILE = resolve(STATE_ROOT, "server.json");
const LOG_FILE = resolve(STATE_ROOT, "server.log");
const HEALTH_PATH = "/__velvet_configurator_health";
const STOP_PATH = "/__velvet_configurator_stop";
const TOKEN_HEADER = "x-velvet-configurator-token";
const INTERNAL_COMMAND = "__serve";
const COMMANDS = new Set(["start", "stop", "version", "help"]);

const CONTENT_TYPES = new Map([
  [".css", "text/css; charset=utf-8"],
  [".html", "text/html; charset=utf-8"],
  [".js", "text/javascript; charset=utf-8"],
  [".json", "application/json; charset=utf-8"],
  [".map", "application/json; charset=utf-8"],
  [".svg", "image/svg+xml"],
  [".ttf", "font/ttf"],
  [".woff", "font/woff"],
  [".woff2", "font/woff2"],
]);

export function helpText() {
  return `Velvet Configurator

Usage: ./config <command>

Commands:
  start    Start the local configurator server and open it in the browser
  stop     Stop the local configurator server
  version  Show the configurator version
  help     Show this help

URL: ${CONFIGURATOR_URL}`;
}

export function parseCommand(args) {
  if (args.length === 0) return "help";
  if (args.length !== 1) {
    throw new Error(`Expected one command, received ${args.length}.`);
  }
  const [command] = args;
  if (!COMMANDS.has(command)) throw new Error(`Unknown command: ${command}`);
  return command;
}

export function resolveStaticPath(pathname, webRoot = WEB_ROOT) {
  let decoded;
  try {
    decoded = decodeURIComponent(pathname);
  } catch {
    return null;
  }

  const requested = decoded === "/" ? "index.html" : decoded.replace(/^\/+/, "");
  const candidate = resolve(webRoot, requested);
  const relation = relative(webRoot, candidate);
  if (relation === ".." || relation.startsWith(`..${sep}`) || isAbsolute(relation)) {
    return null;
  }
  return candidate;
}

function versionText() {
  try {
    const revision = execFileSync(
      "git",
      ["describe", "--tags", "--always", "--dirty"],
      { cwd: PROJECT_ROOT, encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] },
    ).trim();
    return `Velvet Configurator ${revision || "development"}`;
  } catch {
    return "Velvet Configurator development";
  }
}

function readState() {
  try {
    const value = JSON.parse(readFileSync(STATE_FILE, "utf8"));
    if (
      typeof value?.pid !== "number" ||
      typeof value?.token !== "string" ||
      value.token.length < 16
    ) {
      return null;
    }
    return value;
  } catch {
    return null;
  }
}

function clearState(token) {
  const current = readState();
  if (token && current?.token !== token) return;
  try {
    unlinkSync(STATE_FILE);
  } catch (error) {
    if (error?.code !== "ENOENT") throw error;
  }
}

async function managedRequest(pathname, state, method = "GET") {
  try {
    return await fetch(`${CONFIGURATOR_URL}${pathname}`, {
      method,
      headers: { [TOKEN_HEADER]: state.token },
      signal: AbortSignal.timeout(600),
    });
  } catch {
    return null;
  }
}

async function isManagedServer(state) {
  if (!state) return false;
  const response = await managedRequest(HEALTH_PATH, state);
  return response?.status === 204;
}

function openBrowser() {
  if (process.env.VELVET_CONFIG_NO_OPEN === "1") return;
  const command =
    process.platform === "darwin"
      ? ["open", [CONFIGURATOR_URL]]
      : process.platform === "win32"
        ? ["cmd", ["/c", "start", "", CONFIGURATOR_URL]]
        : ["xdg-open", [CONFIGURATOR_URL]];
  try {
    spawn(command[0], command[1], { detached: true, stdio: "ignore" }).unref();
  } catch {
    // The server remains usable when no desktop browser command is available.
  }
}

async function startServer() {
  if (!existsSync(resolve(WEB_ROOT, "index.html"))) {
    throw new Error("Configurator assets are missing. Run npm run configurator:build first.");
  }

  const active = readState();
  if (await isManagedServer(active)) {
    openBrowser();
    console.log(`Velvet Configurator is already running at ${CONFIGURATOR_URL}`);
    return;
  }
  clearState(active?.token);

  mkdirSync(STATE_ROOT, { recursive: true });
  const token = randomUUID();
  const logDescriptor = openSync(LOG_FILE, "w");
  const child = spawn(process.execPath, [COMMAND_PATH, INTERNAL_COMMAND], {
    cwd: PROJECT_ROOT,
    detached: true,
    env: {
      ...process.env,
      VELVET_CONFIG_SERVER_TOKEN: token,
    },
    stdio: ["ignore", logDescriptor, logDescriptor],
  });
  closeSync(logDescriptor);
  child.unref();

  for (let attempt = 0; attempt < 50; attempt += 1) {
    await new Promise((resolveDelay) => setTimeout(resolveDelay, 40));
    const state = readState();
    if (state?.token === token && (await isManagedServer(state))) {
      openBrowser();
      console.log(`Velvet Configurator started at ${CONFIGURATOR_URL}`);
      return;
    }
    if (child.exitCode !== null) break;
  }

  let detail = "";
  try {
    detail = readFileSync(LOG_FILE, "utf8").trim();
  } catch {
    // The primary failure message remains actionable without a log file.
  }
  throw new Error(
    detail
      ? `Configurator server failed to start: ${detail}`
      : "Configurator server failed to start.",
  );
}

async function stopServer() {
  const state = readState();
  if (!(await isManagedServer(state))) {
    clearState(state?.token);
    console.log("Velvet Configurator is not running.");
    return;
  }

  const response = await managedRequest(STOP_PATH, state, "POST");
  if (response?.status !== 202) {
    throw new Error("The configurator server did not accept the stop request.");
  }

  for (let attempt = 0; attempt < 50; attempt += 1) {
    await new Promise((resolveDelay) => setTimeout(resolveDelay, 40));
    if (!(await isManagedServer(state))) {
      clearState(state.token);
      console.log("Velvet Configurator stopped.");
      return;
    }
  }
  throw new Error("The configurator server did not stop cleanly.");
}

function send(response, statusCode, body = "") {
  response.writeHead(statusCode, {
    "cache-control": "no-store",
    "content-length": Buffer.byteLength(body),
    "content-type": "text/plain; charset=utf-8",
  });
  response.end(body);
}

function serveConfigurator(token) {
  const server = createServer((request, response) => {
    void (async () => {
      const url = new URL(request.url ?? "/", CONFIGURATOR_URL);
      const authorized = request.headers[TOKEN_HEADER] === token;

      if (url.pathname === HEALTH_PATH) {
        send(response, authorized ? 204 : 404);
        return;
      }
      if (url.pathname === STOP_PATH) {
        if (request.method !== "POST" || !authorized) {
          send(response, 404);
          return;
        }
        send(response, 202, "Stopping");
        setImmediate(shutdown);
        return;
      }
      if (request.method !== "GET" && request.method !== "HEAD") {
        send(response, 405, "Method not allowed");
        return;
      }

      const filePath = resolveStaticPath(url.pathname);
      if (!filePath) {
        send(response, 404, "Not found");
        return;
      }

      let fileStat;
      try {
        fileStat = statSync(filePath);
      } catch {
        send(response, 404, "Not found");
        return;
      }
      if (!fileStat.isFile()) {
        send(response, 404, "Not found");
        return;
      }

      response.writeHead(200, {
        "cache-control": "no-store",
        "content-length": fileStat.size,
        "content-type": CONTENT_TYPES.get(extname(filePath)) ?? "application/octet-stream",
      });
      if (request.method === "HEAD") response.end();
      else createReadStream(filePath).pipe(response);
    })().catch((error) => {
      console.error(error);
      if (!response.headersSent) send(response, 500, "Internal server error");
      else response.destroy();
    });
  });

  let shuttingDown = false;
  const shutdown = () => {
    if (shuttingDown) return;
    shuttingDown = true;
    server.close(() => {
      clearState(token);
      process.exit(0);
    });
    server.closeAllConnections();
  };

  server.on("error", (error) => {
    console.error(error.message);
    clearState(token);
    process.exit(1);
  });
  server.listen(PORT, HOST, () => {
    mkdirSync(STATE_ROOT, { recursive: true });
    writeFileSync(
      STATE_FILE,
      `${JSON.stringify({ pid: process.pid, token, url: CONFIGURATOR_URL })}\n`,
      { mode: 0o600 },
    );
  });
  process.on("SIGINT", shutdown);
  process.on("SIGTERM", shutdown);
}

export async function run(args = process.argv.slice(2)) {
  if (args[0] === INTERNAL_COMMAND) {
    const token = process.env.VELVET_CONFIG_SERVER_TOKEN;
    if (!token) throw new Error("Missing internal server token.");
    serveConfigurator(token);
    return;
  }

  const command = parseCommand(args);
  if (command === "help") console.log(helpText());
  else if (command === "version") console.log(versionText());
  else if (command === "start") await startServer();
  else if (command === "stop") await stopServer();
}

if (resolve(process.argv[1] ?? "") === COMMAND_PATH) {
  run().catch((error) => {
    console.error(error.message);
    if (error.message.startsWith("Unknown command") || error.message.startsWith("Expected one")) {
      console.error(`\n${helpText()}`);
    }
    process.exitCode = 1;
  });
}
