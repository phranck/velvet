# Copy to .env.local and paste the values from the Zerops secret environment.
# Bun loads .env.local automatically, so nothing else has to be configured.
#
# .env.local is git-ignored. Never commit it, and never paste these into an
# issue, a pull request, or a log.
#
# GITHUB_TOKEN alone is enough for the repository-scoped verification, which is
# what `scripts/verify-against-github.ts` needs. The two values below are only
# for the paths that talk to GitHub as the Velvet App itself: the scheduled
# security sweep and browser onboarding.

# A personal token with `repo` and `delete_repo`, for the disposable repository.
GITHUB_TOKEN=

# The Velvet GitHub App, from the Zerops secret environment.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
